cat > index.html << 'HTMLEOF'
<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<meta name="theme-color" content="#000000">
<title>Остановки Бреста</title>

<!-- MapLibre GL -->
<link href="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.css" rel="stylesheet">
<script src="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.js"></script>
<!-- QR Code -->
<script src="https://cdn.jsdelivr.net/npm/qrcode@1.5.3/build/qrcode.min.js"></script>

<style>
/* ═══════════════════════════════════════════════════════════════
   🍎 APPLE STYLE — SF Pro, Liquid Glass, Premium
   ═══════════════════════════════════════════════════════════════ */

:root {
  --bg: #000000;
  --bg-elevated: rgba(28, 28, 30, 0.72);
  --bg-glass: rgba(28, 28, 30, 0.6);
  --border-glass: rgba(255, 255, 255, 0.08);
  --border-elevated: rgba(255, 255, 255, 0.12);
  --text: #ffffff;
  --text-secondary: rgba(235, 235, 245, 0.6);
  --text-tertiary: rgba(235, 235, 245, 0.3);
  --accent: #0a84ff;
  --accent-hover: #409cff;
  --success: #30d158;
  --warning: #ff9f0a;
  --danger: #ff453a;
  --radius-sm: 10px;
  --radius-md: 14px;
  --radius-lg: 20px;
  --radius-xl: 28px;
  --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.4);
  --shadow-md: 0 4px 16px rgba(0, 0, 0, 0.5);
  --shadow-lg: 0 12px 40px rgba(0, 0, 0, 0.6);
  --font: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", "Helvetica Neue", sans-serif;
}

* { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }

html, body {
  height: 100%;
  overflow: hidden;
  background: var(--bg);
  color: var(--text);
  font-family: var(--font);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  letter-spacing: -0.02em;
}

/* ═══ MAP ═══ */
#map {
  position: fixed;
  inset: 0;
  z-index: 1;
}

/* ═══ HEADER ═══ */
.header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  padding: 12px 16px;
  display: flex;
  align-items: center;
  gap: 12px;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.85) 0%, rgba(0, 0, 0, 0.4) 70%, transparent 100%);
  backdrop-filter: saturate(180%) blur(20px);
  -webkit-backdrop-filter: saturate(180%) blur(20px);
  pointer-events: none;
}

.header > * { pointer-events: auto; }

.logo {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 8px 14px;
  background: var(--bg-elevated);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid var(--border-glass);
  border-radius: var(--radius-md);
  font-size: 15px;
  font-weight: 600;
  letter-spacing: -0.01em;
}

.logo-icon {
  width: 24px;
  height: 24px;
  border-radius: 6px;
  background: linear-gradient(135deg, var(--accent) 0%, #0064d1 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  box-shadow: 0 2px 8px rgba(10, 132, 255, 0.4);
}

.search-wrap {
  flex: 1;
  max-width: 380px;
  position: relative;
}

.search-input {
  width: 100%;
  padding: 10px 16px 10px 38px;
  background: var(--bg-elevated);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid var(--border-glass);
  border-radius: var(--radius-md);
  color: var(--text);
  font-family: var(--font);
  font-size: 15px;
  font-weight: 400;
  letter-spacing: -0.01em;
  outline: none;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

.search-input:focus {
  border-color: var(--accent);
  background: rgba(28, 28, 30, 0.85);
  box-shadow: 0 0 0 3px rgba(10, 132, 255, 0.2);
}

.search-input::placeholder { color: var(--text-tertiary); }

.search-icon {
  position: absolute;
  left: 14px;
  top: 50%;
  transform: translateY(-50%);
  font-size: 14px;
  color: var(--text-tertiary);
  pointer-events: none;
}

.header-buttons {
  display: flex;
  gap: 8px;
  margin-left: auto;
}

.btn-icon {
  width: 40px;
  height: 40px;
  border-radius: var(--radius-md);
  background: var(--bg-elevated);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid var(--border-glass);
  color: var(--text);
  font-size: 16px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

.btn-icon:hover {
  background: rgba(58, 58, 60, 0.8);
  border-color: var(--border-elevated);
  transform: scale(1.05);
}

.btn-icon:active {
  transform: scale(0.95);
}

.btn-icon.active {
  background: var(--accent);
  border-color: var(--accent);
  box-shadow: 0 4px 16px rgba(10, 132, 255, 0.4);
}

/* ═══ STOPS PANEL ═══ */
.stops-panel {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 50;
  padding: 20px 16px 24px;
  background: linear-gradient(0deg, rgba(0, 0, 0, 0.95) 0%, rgba(0, 0, 0, 0.7) 60%, transparent 100%);
  pointer-events: none;
  transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.3s ease;
}

.stops-panel.hidden {
  transform: translateY(100%);
  opacity: 0;
}

.stops-scroll {
  display: flex;
  gap: 12px;
  overflow-x: auto;
  padding: 4px 4px 12px;
  pointer-events: auto;
  scrollbar-width: none;
  -webkit-overflow-scrolling: touch;
  scroll-snap-type: x mandatory;
}

.stops-scroll::-webkit-scrollbar { display: none; }

.stop-card {
  flex-shrink: 0;
  width: 260px;
  padding: 18px;
  background: var(--bg-elevated);
  backdrop-filter: saturate(180%) blur(30px);
  -webkit-backdrop-filter: saturate(180%) blur(30px);
  border: 1px solid var(--border-glass);
  border-radius: var(--radius-lg);
  cursor: pointer;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  scroll-snap-align: start;
  position: relative;
  overflow: hidden;
}

.stop-card::after {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: var(--radius-lg);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
  pointer-events: none;
}

.stop-card:hover {
  transform: translateY(-4px) scale(1.02);
  border-color: rgba(255, 255, 255, 0.2);
  box-shadow: var(--shadow-lg);
}

.stop-card:active {
  transform: translateY(-2px) scale(1.0);
}

.stop-name {
  font-size: 16px;
  font-weight: 600;
  letter-spacing: -0.02em;
  margin-bottom: 4px;
  color: var(--text);
}

.stop-address {
  font-size: 13px;
  color: var(--text-secondary);
  margin-bottom: 12px;
  font-weight: 400;
}

.stop-buses {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

.bus-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 32px;
  height: 26px;
  padding: 0 8px;
  background: rgba(10, 132, 255, 0.15);
  border: 1px solid rgba(10, 132, 255, 0.3);
  border-radius: 8px;
  font-size: 12px;
  font-weight: 600;
  color: #5ac8fa;
  letter-spacing: -0.01em;
}

/* ═══ STOP PAGE ═══ */
.stop-page {
  position: fixed;
  inset: 0;
  z-index: 200;
  background: var(--bg);
  overflow-y: auto;
  opacity: 0;
  visibility: hidden;
  transform: translateY(20px);
  transition: opacity 0.4s cubic-bezier(0.4, 0, 0.2, 1),
              visibility 0.4s ease,
              transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.stop-page.active {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}

.stop-page-content {
  max-width: 900px;
  margin: 0 auto;
  padding: 88px 20px 80px;
}

/* Back button */
.back-btn {
  position: fixed;
  top: 16px;
  left: 16px;
  z-index: 210;
  height: 40px;
  padding: 0 16px 0 12px;
  display: flex;
  align-items: center;
  gap: 6px;
  background: var(--bg-elevated);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid var(--border-glass);
  border-radius: var(--radius-md);
  color: var(--text);
  font-family: var(--font);
  font-size: 15px;
  font-weight: 500;
  letter-spacing: -0.01em;
  cursor: pointer;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

.back-btn:hover {
  background: rgba(58, 58, 60, 0.85);
  transform: translateX(-2px);
}

.back-btn:active {
  transform: scale(0.96);
}

/* Hero */
.hero {
  margin-bottom: 28px;
  animation: fadeUp 0.5s cubic-bezier(0.4, 0, 0.2, 1);
}

.hero-title {
  font-size: 40px;
  font-weight: 700;
  letter-spacing: -0.03em;
  line-height: 1.1;
  margin-bottom: 8px;
  background: linear-gradient(135deg, #ffffff 0%, #a1a1a6 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.hero-address {
  font-size: 17px;
  color: var(--text-secondary);
  font-weight: 400;
  display: flex;
  align-items: center;
  gap: 6px;
}

.hero-badge {
  display: inline-block;
  margin-top: 14px;
  padding: 6px 12px;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid var(--border-glass);
  border-radius: 100px;
  font-size: 12px;
  font-weight: 600;
  color: var(--text-secondary);
  letter-spacing: 0.02em;
  text-transform: uppercase;
}

/* Next bus */
.next-bus {
  padding: 24px;
  background: linear-gradient(135deg, rgba(10, 132, 255, 0.18) 0%, rgba(28, 28, 30, 0.9) 100%);
  backdrop-filter: blur(30px);
  -webkit-backdrop-filter: blur(30px);
  border: 1px solid rgba(10, 132, 255, 0.3);
  border-radius: var(--radius-xl);
  margin-bottom: 20px;
  position: relative;
  overflow: hidden;
  animation: fadeUp 0.5s 0.05s cubic-bezier(0.4, 0, 0.2, 1) backwards;
  box-shadow: 0 12px 40px rgba(0, 0, 0, 0.5);
}

.next-bus::before {
  content: "";
  position: absolute;
  top: -50%;
  right: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle at 30% 30%, rgba(10, 132, 255, 0.15) 0%, transparent 60%);
  animation: rotateGlow 12s linear infinite;
}

@keyframes rotateGlow {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.next-label {
  font-size: 12px;
  font-weight: 600;
  color: #5ac8fa;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  margin-bottom: 14px;
  position: relative;
  z-index: 1;
}

.next-row {
  display: flex;
  align-items: baseline;
  gap: 14px;
  position: relative;
  z-index: 1;
  flex-wrap: wrap;
}

.next-number {
  font-size: 56px;
  font-weight: 800;
  letter-spacing: -0.04em;
  line-height: 1;
  color: #ffffff;
}

.next-time {
  font-size: 15px;
  color: var(--text-secondary);
  font-weight: 500;
}

.next-in {
  margin-left: auto;
  padding: 8px 14px;
  background: rgba(48, 209, 88, 0.15);
  border: 1px solid rgba(48, 209, 88, 0.3);
  border-radius: 100px;
  font-size: 14px;
  font-weight: 600;
  color: var(--success);
  letter-spacing: -0.01em;
}

/* Section */
.section {
  margin-bottom: 28px;
  animation: fadeUp 0.5s cubic-bezier(0.4, 0, 0.2, 1) backwards;
}

.section:nth-child(3) { animation-delay: 0.1s; }
.section:nth-child(4) { animation-delay: 0.15s; }
.section:nth-child(5) { animation-delay: 0.2s; }
.section:nth-child(6) { animation-delay: 0.25s; }

.section-title {
  font-size: 22px;
  font-weight: 700;
  letter-spacing: -0.02em;
  margin-bottom: 14px;
  color: var(--text);
}

/* Buses grid */
.buses-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(80px, 1fr));
  gap: 10px;
}

.bus-item {
  padding: 16px 8px;
  background: var(--bg-elevated);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid var(--border-glass);
  border-radius: var(--radius-md);
  text-align: center;
  font-size: 22px;
  font-weight: 700;
  letter-spacing: -0.02em;
  color: var(--text);
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  cursor: pointer;
}

.bus-item:hover {
  border-color: rgba(10, 132, 255, 0.5);
  background: rgba(10, 132, 255, 0.1);
  transform: translateY(-2px);
}

/* Schedule */
.schedule-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.schedule-row {
  display: flex;
  gap: 14px;
  padding: 14px 16px;
  background: var(--bg-elevated);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid var(--border-glass);
  border-radius: var(--radius-md);
  align-items: flex-start;
  transition: all 0.2s ease;
}

.schedule-row:hover {
  border-color: var(--border-elevated);
}

.schedule-bus {
  width: 44px;
  flex-shrink: 0;
  text-align: center;
  font-size: 20px;
  font-weight: 700;
  letter-spacing: -0.02em;
  color: #5ac8fa;
  padding-top: 2px;
}

.schedule-times {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  flex: 1;
}

.time-chip {
  display: inline-block;
  padding: 5px 10px;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid transparent;
  border-radius: 7px;
  font-size: 13px;
  font-weight: 500;
  color: var(--text);
  letter-spacing: -0.01em;
  font-variant-numeric: tabular-nums;
  transition: all 0.2s ease;
}

.time-chip.past {
  opacity: 0.35;
  color: var(--text-tertiary);
}

.time-chip.next {
  background: var(--accent);
  color: #ffffff;
  border-color: var(--accent);
  box-shadow: 0 2px 12px rgba(10, 132, 255, 0.5);
  font-weight: 700;
}

/* Mini map */
#mini-map {
  height: 280px;
  border-radius: var(--radius-lg);
  overflow: hidden;
  border: 1px solid var(--border-glass);
  box-shadow: var(--shadow-md);
}

/* Nearby */
.nearby-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.nearby-btn {
  padding: 12px 18px;
  background: var(--bg-elevated);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid var(--border-glass);
  border-radius: var(--radius-md);
  color: var(--text);
  font-family: var(--font);
  font-size: 15px;
  font-weight: 500;
  letter-spacing: -0.01em;
  cursor: pointer;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

.nearby-btn:hover {
  border-color: var(--border-elevated);
  background: rgba(58, 58, 60, 0.8);
  transform: translateY(-2px);
}

.nearby-btn:active {
  transform: scale(0.98);
}

/* Description */
.description {
  font-size: 15px;
  line-height: 1.5;
  color: var(--text-secondary);
  padding: 16px 18px;
  background: var(--bg-elevated);
  border-radius: var(--radius-md);
  border: 1px solid var(--border-glass);
}

/* ═══ QR PAGE ═══ */
.qr-page {
  position: fixed;
  inset: 0;
  z-index: 200;
  background: var(--bg);
  overflow-y: auto;
  opacity: 0;
  visibility: hidden;
  transform: translateY(20px);
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.qr-page.active {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}

.qr-content {
  max-width: 1100px;
  margin: 0 auto;
  padding: 88px 20px 60px;
}

.qr-header h1 {
  font-size: 40px;
  font-weight: 700;
  letter-spacing: -0.03em;
  margin-bottom: 8px;
}

.qr-header p {
  font-size: 15px;
  color: var(--text-secondary);
  font-weight: 400;
}

.qr-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 16px;
  margin-top: 28px;
}

.qr-card {
  padding: 20px;
  background: var(--bg-elevated);
  backdrop-filter: blur(30px);
  -webkit-backdrop-filter: blur(30px);
  border: 1px solid var(--border-glass);
  border-radius: var(--radius-lg);
  text-align: center;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  animation: fadeUp 0.5s cubic-bezier(0.4, 0, 0.2, 1) backwards;
}

.qr-card:hover {
  border-color: var(--border-elevated);
  transform: translateY(-4px);
  box-shadow: var(--shadow-lg);
}

.qr-card h3 {
  font-size: 16px;
  font-weight: 600;
  letter-spacing: -0.01em;
  margin-bottom: 4px;
}

.qr-card .qr-addr {
  font-size: 12px;
  color: var(--text-secondary);
  margin-bottom: 14px;
}

.qr-card canvas {
  background: #ffffff;
  padding: 10px;
  border-radius: var(--radius-sm);
  display: block;
  margin: 0 auto;
  max-width: 100%;
}

/* ═══ ANIMATIONS ═══ */
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(16px); }
  to { opacity: 1; transform: translateY(0); }
}

/* ═══ MAP STYLES — MapTiler ═══ */
.maplibregl-popup-content {
  background: rgba(28, 28, 30, 0.92) !important;
  backdrop-filter: blur(30px) saturate(180%);
  -webkit-backdrop-filter: blur(30px) saturate(180%);
  border: 1px solid var(--border-elevated) !important;
  border-radius: var(--radius-lg) !important;
  padding: 16px !important;
  color: var(--text) !important;
  box-shadow: var(--shadow-lg) !important;
  font-family: var(--font) !important;
  min-width: 240px;
}

.maplibregl-popup-tip {
  border-top-color: rgba(28, 28, 30, 0.92) !important;
  border-bottom-color: rgba(28, 28, 30, 0.92) !important;
}

.maplibregl-popup-close-button {
  color: var(--text-secondary) !important;
  font-size: 22px !important;
  padding: 4px 10px !important;
  border-radius: 0 var(--radius-lg) 0 0;
}

.maplibregl-popup-close-button:hover {
  color: var(--text) !important;
  background: rgba(255, 255, 255, 0.06) !important;
}

.maplibregl-ctrl-attrib {
  background: rgba(0, 0, 0, 0.5) !important;
  color: var(--text-tertiary) !important;
  font-size: 10px !important;
}

.maplibregl-ctrl-attrib a { color: var(--text-secondary) !important; }

/* Popup */
.popup-title {
  font-size: 17px;
  font-weight: 600;
  letter-spacing: -0.02em;
  margin-bottom: 6px;
  color: var(--text);
}

.popup-addr {
  font-size: 13px;
  color: var(--text-secondary);
  margin-bottom: 12px;
}

.popup-buses {
  display: flex;
  flex-wrap: wrap;
  gap: 5px;
  margin-bottom: 14px;
}

.popup-btn {
  width: 100%;
  padding: 10px;
  background: var(--accent);
  border: none;
  border-radius: var(--radius-sm);
  color: #ffffff;
  font-family: var(--font);
  font-size: 14px;
  font-weight: 600;
  letter-spacing: -0.01em;
  cursor: pointer;
  transition: all 0.2s ease;
}

.popup-btn:hover {
  background: var(--accent-hover);
  transform: translateY(-1px);
}

.popup-btn:active {
  transform: scale(0.98);
}

/* ═══ MOBILE ═══ */
@media (max-width: 768px) {
  .header { padding: 10px 12px; gap: 8px; }
  .logo { padding: 8px 12px; font-size: 14px; }
  .logo-icon { width: 20px; height: 20px; font-size: 12px; }
  .search-wrap { max-width: none; }
  .hero-title { font-size: 30px; }
  .next-number { font-size: 44px; }
  .stop-card { width: 220px; }
  .stop-page-content, .qr-content { padding-top: 76px; }
  .qr-header h1 { font-size: 30px; }
}

/* ═══ SCROLLBAR ═══ */
::-webkit-scrollbar { width: 8px; height: 8px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb {
  background: rgba(255, 255, 255, 0.15);
  border-radius: 4px;
}
