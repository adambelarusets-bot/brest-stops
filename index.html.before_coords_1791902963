   ═══════════════════════════════════════════════════════════════ */
function openStopPage(stopId) {
  const stop = STOPS.find(s => s.id === stopId);
  if (!stop) return;

  document.getElementById('stops-panel').classList.add('hidden');

  const container = document.getElementById('stop-page-content');
  const next = getNextBus(stop);
  const now = new Date();
  const nowTime = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;

  const scheduleHTML = Object.entries(stop.schedule).map(([bus, times]) => {
    const timesHTML = times.map(t => {
      const isPast = t < nowTime;
      const isNext = !isPast && times.filter(x => x >= nowTime)[0] === t;
      const cls = isPast ? 'past' : (isNext ? 'next' : '');
      return `<span class="time-chip ${cls}">${t}</span>`;
    }).join('');
    return `
      <div class="schedule-row">
        <div class="schedule-bus">${bus}</div>
        <div class="schedule-times">${timesHTML}</div>
      </div>
    `;
  }).join('');

  const nearbyHTML = stop.nearby.map(id => {
    const n = STOPS.find(s => s.id === id);
    return n ? `<button class="nearby-btn" onclick="openStopPage('${n.id}')">${n.name} →</button>` : '';
  }).join('');

  container.innerHTML = `
    <div class="hero">
      <h1 class="hero-title">${stop.name}</h1>
      <div class="hero-address">📍 ${stop.address}</div>
      <div class="hero-badge">с ${stop.built} года</div>
    </div>

    ${next ? `
      <div class="next-bus">
        <div class="next-label">Следующий автобус</div>
        <div class="next-row">
          <div class="next-number">${next.bus}</div>
          <div class="next-time">в ${next.time}</div>
          <div class="next-in">через ${next.inMinutes} мин</div>
        </div>
      </div>
    ` : ''}

    <div class="section">
      <div class="section-title">Маршруты</div>
      <div class="buses-grid">
        ${stop.buses.map(b => `<div class="bus-item">${b}</div>`).join('')}
      </div>
    </div>

    <div class="section">
      <div class="section-title">Описание</div>
      <div class="description">${stop.description}</div>
    </div>

    <div class="section">
      <div class="section-title">Расписание</div>
      <div class="schedule-list">${scheduleHTML}</div>
    </div>

    <div class="section">
      <div class="section-title">Рядом</div>
      <div class="nearby-list">${nearbyHTML}</div>
    </div>

    <div class="section">
      <div class="section-title">На карте</div>
      <div id="mini-map"></div>
    </div>
  `;

  document.getElementById('stop-page').classList.add('active');
  document.title = stop.name + ' — Остановки Бреста';
  document.querySelector('.stop-page').scrollTop = 0;

  if (miniMap) { miniMap.remove(); miniMap = null; }

  setTimeout(() => {
    miniMap = new maplibregl.Map({
      container: 'mini-map',
      style: MAP_STYLES[currentStyle],
      center: stop.coords,
      zoom: 16,
      pitch: 50,
      bearing: -15
    });

    const el = document.createElement('div');
    el.style.cssText = `
      width: 36px;
      height: 36px;
      background: linear-gradient(135deg, #0a84ff 0%, #0064d1 100%);
      border: 4px solid #ffffff;
      border-radius: 50%;
      box-shadow: 0 6px 24px rgba(10, 132, 255, 0.7), 0 0 0 6px rgba(10, 132, 255, 0.2);
    `;

    new maplibregl.Marker({ element: el })
      .setLngLat(stop.coords)
      .addTo(miniMap);
  }, 100);

  location.hash = 'stop=' + stop.id;
}

function closeStopPage() {
  document.getElementById('stop-page').classList.remove('active');
  document.getElementById('stops-panel').classList.remove('hidden');
  document.title = 'Остановки Бреста';
  location.hash = '';
