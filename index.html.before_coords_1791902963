/* ═══════════════════════════════════════════════════════════════
   ⏱ БЛИЖАЙШИЙ АВТОБУС
   ═══════════════════════════════════════════════════════════════ */
function getNextBus(stop) {
  const now = new Date();
  const nowMin = now.getHours() * 60 + now.getMinutes();
  let best = null;

  for (const [bus, times] of Object.entries(stop.schedule)) {
    for (const time of times) {
      const [h, m] = time.split(':').map(Number);
      const min = h * 60 + m;
      if (min >= nowMin && (!best || min < best.minutes)) {
        best = { bus, time, minutes: min, inMinutes: min - nowMin };
      }
    }
  }
  return best;
}

