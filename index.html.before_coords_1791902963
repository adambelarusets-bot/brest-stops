   🔗 HASH ROUTING
   ═══════════════════════════════════════════════════════════════ */
function handleHash() {
  const hash = location.hash;
  if (hash.startsWith('#stop=')) {
    openStopPage(hash.slice(6));
  } else if (hash === '#qr') {
    openQRPage();
  } else {
    closeStopPage();
    closeQRPage();
  }
}

window.addEventListener('hashchange', handleHash);

