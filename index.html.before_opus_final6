      { id: "agrotrans", name: "Агротранс", address: "ул. Речицкая", coords: [23.649697, 52.098582], built: "1990", state: "good", surface: "asphalt", has_square: false, has_shop: true, bins: 2, benches: 2, trees: 1, trainers: false, buses: ["5","9","9а","44","44а","50","54"], schedule: { "9": ["05:37","06:10","06:41","07:14","07:43","08:17","08:59","10:00","11:00","11:55","13:00","14:07","15:03","16:07","17:05","18:05","18:55","20:05","21:35","22:45","23:50"], "44": ["06:00","06:26","06:57","07:32","08:15","16:40","17:09","17:43","18:22"], "50": ["06:05","06:35","07:05","07:35","08:05","08:35","09:05","10:05","11:05","12:05","13:05","14:05","15:05","16:05","17:05","18:05","19:05","20:05","21:05"] }, description: "Остановка у предприятия «Агротранс».", nearby: ["shkola", "rybtorg"] },
      { id: "rybtorg", name: "База «Рыбторг»", address: "ул. Речицкая", coords: [23.650102, 52.094773], built: "1988", state: "bad", surface: "grass", has_square: false, has_shop: false, bins: 0, benches: 1, trees: 0, trainers: false, buses: ["9","9а","44","44а"], schedule: { "9": ["05:39","06:12","06:43","07:16","07:45","08:19","09:01","10:02","11:02","11:57","13:02","14:09","15:05","16:09","17:07","18:07","18:57","20:07","21:37","22:47","23:52"], "44": ["06:02","06:28","06:59","07:34","08:17","16:42","17:11","17:45","18:24"] }, description: "Остановка у базы «Рыбторг».", nearby: ["agrotrans", "myasokombinat"] },
      { id: "myasokombinat", name: "Мясокомбинат", address: "ул. Писателя Смирнова", coords: [23.644367, 52.094866], built: "1975", state: "good", surface: "tile", has_square: true, has_shop: true, bins: 4, benches: 5, trees: 6, trainers: true, buses: ["9","9а","9Д","44","44а","50"], schedule: { "9": ["05:43","06:16","06:47","07:20","07:49","08:23","09:05","10:06","11:06","12:01","13:06","14:13","15:09","16:13","17:11","18:11","19:01","20:11","21:41","22:51","23:56"], "44": ["05:55","06:21","06:52","07:27","08:10","16:35","17:04","17:38","18:17"], "50": ["06:00","06:30","07:00","07:30","08:00","08:30","09:00","10:00","11:00","12:00","13:00","14:00","15:00","16:00","17:00","18:00","19:00","20:00","21:00"] }, description: "Конечная маршрута №9.", nearby: ["rybtorg", "rechickaya"] }
    ];

    // === КАРТА ===
    const MAPTILER_KEY = 'jglHccatCYM4tRmZ1J1w';
    const MAP_STYLES = {
      streets: `https://api.maptiler.com/maps/streets-v2-dark/style.json?key=${MAPTILER_KEY}`,
      satellite: `https://api.maptiler.com/maps/hybrid/style.json?key=${MAPTILER_KEY}`,
      basic: `https://api.maptiler.com/maps/basic-v2-dark/style.json?key=${MAPTILER_KEY}`
    };

    let map, markers = {}, currentStyle = 'streets', userMarker = null, layerMode = 'state';

    function initMap() {
      map = new maplibregl.Map({
        container: 'map', style: MAP_STYLES[currentStyle],
        center: [23.648, 52.102], zoom: 14, pitch: 50, bearing: -15
      });
      map.on('load', () => { addMarkers(); });
    }

    function addMarkers() {
      Object.values(markers).forEach(m => m.remove());
      markers = {};
      STOPS.forEach(stop => {
        const el = document.createElement('div');
        let color = '#30d158';
        if (layerMode === 'state') {
          if (stop.state === 'satisfactory') color = '#ff9f0a';
          if (stop.state === 'bad') color = '#ff453a';
        } else if (layerMode === 'surface') {
          color = stop.surface === 'asphalt' ? '#8e8e93' : stop.surface === 'tile' ? '#5ac8fa' : '#30d158';
        } else if (layerMode === 'objects') {
          color = (stop.has_square && stop.has_shop) ? '#30d158' : (stop.has_square || stop.has_shop) ? '#ff9f0a' : '#ff453a';
        }
        el.style.cssText = `width:30px;height:30px;background:${color};border:3px solid #fff;border-radius:50%;cursor:pointer;box-shadow:0 4px 16px ${color}99;transition:transform 0.2s ease;`;
        el.addEventListener('mouseenter', () => el.style.transform = 'scale(1.3)');
        el.addEventListener('mouseleave', () => el.style.transform = 'scale(1)');
        const marker = new maplibregl.Marker({ element: el }).setLngLat(stop.coords).addTo(map);
        el.addEventListener('click', () => showMiniCard(stop.id));
        markers[stop.id] = marker;
      });
    }

    function showMiniCard(stopId) {
      const stop = STOPS.find(s => s.id === stopId);
      if (!stop) return;
      document.getElementById('mini-title').textContent = stop.name;
      document.getElementById('mini-addr').textContent = '📍 ' + stop.address;
      document.getElementById('mini-buses').innerHTML = stop.buses.slice(0, 5).map(b => `<span class="bus-chip">${b}</span>`).join('');
      const surfaceText = stop.surface === 'tile' ? 'Плитка' : stop.surface === 'grass' ? 'Трава' : 'Асфальт';
      document.getElementById('mini-info').innerHTML = `
        <div><span class="ico blue">🟢</span> Состояние: ${stop.state === 'good' ? 'Хорошее' : stop.state === 'satisfactory' ? 'Удовл.' : 'Требует внимания'}</div>
        <div><span class="ico green">🛣</span> Покрытие: ${surfaceText}</div>
        <div><span class="ico orange">🌳</span> Сквер: ${stop.has_square ? 'Есть' : 'Нет'}</div>
        <div><span class="ico purple">🛒</span> Магазин: ${stop.has_shop ? 'Есть' : 'Нет'}</div>
        <div><span class="ico teal">🗑</span> Урны: ${stop.bins} шт.</div>
        <div><span class="ico blue">🪑</span> Лавочки: ${stop.benches} шт.</div>
        <div><span class="ico green">🌲</span> Деревья: ${stop.trees} шт.</div>
        <div><span class="ico orange">🏋️</span> Тренажеры: ${stop.trainers ? 'Есть' : 'Нет'}</div>
      `;
      document.getElementById('mini-btn').onclick = () => openStopPage(stop.id);
      document.getElementById('mini-card').classList.add('show');
    }

    document.getElementById('btn-style').addEventListener('click', () => {
      const order = ['streets', 'satellite', 'basic'];
      currentStyle = order[(order.indexOf(currentStyle) + 1) % order.length];
      map.setStyle(MAP_STYLES[currentStyle]);
      map.once('styledata', addMarkers);
    });

    document.getElementById('btn-layers').addEventListener('click', () => {
      const modes = ['state', 'surface', 'objects'];
      layerMode = modes[(modes.indexOf(layerMode) + 1) % modes.length];
      addMarkers();
    });

    document.getElementById('btn-locate').addEventListener('click', () => {
      if (!navigator.geolocation) return alert('Геолокация не поддерживается');
      navigator.geolocation.watchPosition((pos) => {
        const { latitude, longitude } = pos.coords;
        if (!userMarker) {
          const el = document.createElement('div');
          el.style.cssText = `width:20px;height:20px;background:#0a84ff;border:3px solid #fff;border-radius:50%;box-shadow:0 0 0 8px rgba(10,132,255,0.3);`;
          userMarker = new maplibregl.Marker({ element: el }).setLngLat([longitude, latitude]).addTo(map);
        } else userMarker.setLngLat([longitude, latitude]);
        map.flyTo({ center: [longitude, latitude], zoom: 16 });
      }, (err) => alert('Ошибка GPS: ' + err.message), { enableHighAccuracy: true });
    });

    function openStopPage(stopId) {
      const stop = STOPS.find(s => s.id === stopId);
      if (!stop) return;
      document.getElementById('mini-card').classList.remove('show');
      document.getElementById('stop-page-content').innerHTML = `
        <button class="back-btn" onclick="closeStopPage()">← Назад</button>
        <h1>${stop.name}</h1>
        <p class="stop-meta"><span class="addr">${stop.address}</span><span class="year">с ${stop.built} года</span></p>
        <section><h2>Маршруты</h2><div class="routes">${stop.buses.map(b => `<span>${b}</span>`).join('')}</div></section>
        <section><h2>Описание</h2><div class="description">${stop.description}</div></section>
        <section><h2>Инфраструктура</h2><ul class="infra">
          <li><span class="ico teal">🗑</span> Урны <span class="value">${stop.bins}</span></li>
          <li><span class="ico blue">🪑</span> Лавочки <span class="value">${stop.benches}</span></li>
          <li><span class="ico green">🌲</span> Деревья <span class="value">${stop.trees}</span></li>
          <li><span class="ico orange">🏋️</span> Тренажеры <span class="value">${stop.trainers ? 'Есть' : 'Нет'}</span></li>
          <li><span class="ico orange">🌳</span> Сквер <span class="value">${stop.has_square ? 'Есть' : 'Нет'}</span></li>
          <li><span class="ico purple">🛒</span> Магазин <span class="value">${stop.has_shop ? 'Есть' : 'Нет'}</span></li>
        </ul></section>
        <section><h2>Расписание</h2><div class="schedule">${Object.entries(stop.schedule).map(([bus, times]) => `<div class="schedule-row"><span class="bus-chip">${bus}</span><div class="times">${times.map(t => `<span class="time-chip">${t}</span>`).join('')}</div></div>`).join('')}</div></section>
        <section><h2>Рядом</h2><div class="nearby">${stop.nearby.map(id => { const n = STOPS.find(s => s.id === id); return n ? `<button class="nearby-btn" onclick="openStopPage('${n.id}')">${n.name} →</button>` : ''; }).join('')}</div></section>
        <section><h2>На карте</h2><div id="mini-map"></div></section>
      `;
      document.getElementById('stop-page').classList.add('show');
      setTimeout(() => {
        if (window.miniMap) window.miniMap.remove();
        window.miniMap = new maplibregl.Map({
          container: 'mini-map', style: MAP_STYLES[currentStyle],
          center: stop.coords, zoom: 16, pitch: 50, bearing: -15
        });
        const el = document.createElement('div');
        el.style.cssText = `width:36px;height:36px;background:linear-gradient(135deg,#0a84ff,#0064d1);border:4px solid #fff;border-radius:50%;box-shadow:0 6px 24px rgba(10,132,255,0.7);`;
        new maplibregl.Marker({ element: el }).setLngLat(stop.coords).addTo(window.miniMap);
      }, 100);
    }

    function closeStopPage() {
      document.getElementById('stop-page').classList.remove('show');
      if (window.miniMap) { window.miniMap.remove(); window.miniMap = null; }
    }

    document.getElementById('search').addEventListener('input', (e) => {
      const q = e.target.value.toLowerCase();
      const filtered = STOPS.filter(s => s.name.toLowerCase().includes(q) || s.buses.some(b => b.toLowerCase().includes(q)));
      if (filtered.length === 1) map.flyTo({ center: filtered[0].coords, zoom: 16 });
    });

    document.addEventListener('DOMContentLoaded', () => { initMap(); });
  </script>
</body>
</html>