<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#000000">
  <meta name="color-scheme" content="dark">
  <title>Остановки Бреста</title>
  <link rel="stylesheet" href="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.css">
  <style>
    :root {
      --bg: #000;
      --panel: rgba(28, 28, 30, 0.72);
      --panel-strong: rgba(28, 28, 30, 0.86);
      --fill: rgba(118, 118, 128, 0.24);
      --fill-2: rgba(118, 118, 128, 0.16);
      --fill-3: rgba(118, 118, 128, 0.10);
      --separator: rgba(84, 84, 88, 0.55);
      --stroke: rgba(255, 255, 255, 0.08);
      --blue: #0a84ff;
      --blue-tint: rgba(10, 132, 255, 0.18);
      --blue-text: #4da3ff;
      --green: #30d158;
      --orange: #ff9f0a;
      --red: #ff453a;
      --purple: #bf5af2;
      --teal: #64d2ff;
      --label: #fff;
      --label-2: rgba(235, 235, 245, 0.6);
      --label-3: rgba(235, 235, 245, 0.3);
      --r-xs: 8px;
      --r-sm: 12px;
      --r-md: 16px;
      --r: 20px;
      --r-lg: 28px;
      --blur: blur(30px) saturate(180%);
      --shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06), 0 24px 60px rgba(0, 0, 0, 0.55), 0 2px 8px rgba(0, 0, 0, 0.35);
      --shadow-sm: 0 6px 20px rgba(0, 0, 0, 0.35);
      --ease: cubic-bezier(0.4, 0, 0.2, 1);
      --spring: cubic-bezier(0.32, 0.72, 0, 1);
      --font: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", "Helvetica Neue", system-ui, sans-serif;
      --safe-t: env(safe-area-inset-top, 0px);
      --safe-r: env(safe-area-inset-right, 0px);
      --safe-b: env(safe-area-inset-bottom, 0px);
      --safe-l: env(safe-area-inset-left, 0px);
      --header-h: 56px;
      --header-gap: 12px;
      --header-offset: calc(var(--safe-t) + var(--header-gap) + var(--header-h) + 12px);
    }
    *, *::before, *::after { box-sizing: border-box; }
    html, body {
      margin: 0; height: 100%; background: var(--bg); color: var(--label);
      font-family: var(--font); font-size: 15px; line-height: 1.45; font-weight: 400;
      -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale;
      -webkit-tap-highlight-color: transparent; overflow: hidden;
    }
    button, input { font: inherit; color: inherit; }
    button { cursor: pointer; border: 0; background: none; padding: 0; }
    svg { display: block; flex-shrink: 0; }
    :focus { outline: none; }
    :focus-visible { outline: 3px solid rgba(10, 132, 255, 0.6); outline-offset: 2px; }
    [hidden], .hidden { display: none !important; }
    .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
    .glass {
      background: var(--panel); -webkit-backdrop-filter: var(--blur); backdrop-filter: var(--blur);
      border: 1px solid var(--stroke); box-shadow: var(--shadow);
    }
    .glass::before {
      content: ""; position: absolute; inset: 0; border-radius: inherit; padding: 1px;
      background: linear-gradient(180deg, rgba(255,255,255,0.24) 0%, rgba(255,255,255,0.02) 38%, rgba(255,255,255,0) 60%, rgba(255,255,255,0.07) 100%);
      -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
      -webkit-mask-composite: xor; mask-composite: exclude; pointer-events: none; z-index: 0;
    }
    @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
      .glass { background: rgba(28, 28, 30, 0.96); }
    }
    @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
    @keyframes fadeUp { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
    @keyframes slideUp { from { opacity: 0; transform: translateY(48px) scale(0.97); } to { opacity: 1; transform: none; } }
    @keyframes cardIn { from { opacity: 0; transform: translateY(24px) scale(0.95); } to { opacity: 1; transform: none; } }
    @keyframes sheetIn { from { transform: translateY(105%); } to { transform: none; } }
    @keyframes headerIn { from { opacity: 0; transform: translate(-50%, -16px); } to { opacity: 1; transform: translate(-50%, 0); } }
    @keyframes pulse {
      0% { box-shadow: 0 0 0 0 rgba(10, 132, 255, 0.55); }
      70% { box-shadow: 0 0 0 12px rgba(10, 132, 255, 0); }
      100% { box-shadow: 0 0 0 0 rgba(10, 132, 255, 0); }
    }
    .app-header {
      position: fixed; top: calc(var(--safe-t) + var(--header-gap)); left: 50%;
      transform: translateX(-50%); width: min(1120px, calc(100% - 24px - var(--safe-l) - var(--safe-r)));
      height: var(--header-h); padding: 8px 8px 8px 10px; display: flex; align-items: center;
      gap: 12px; border-radius: var(--r-lg); z-index: 40; animation: headerIn 0.6s var(--spring) both;
    }
    .app-header > * { position: relative; z-index: 1; }
    .logo { display: flex; align-items: center; gap: 10px; flex-shrink: 0; text-decoration: none; color: var(--label); user-select: none; }
    .logo-icon {
      width: 40px; height: 40px; border-radius: var(--r-sm); display: grid; place-items: center;
      background: linear-gradient(145deg, #3b9dff 0%, #0a84ff 45%, #0060df 100%);
      box-shadow: inset 0 1px 0 rgba(255,255,255,0.35), 0 6px 16px rgba(10,132,255,0.4); color: #fff;
    }
    .logo-text { font-size: 19px; font-weight: 700; letter-spacing: -0.025em; }
    .search-field { position: relative; flex: 1; min-width: 0; height: 40px; }
    .search-field svg { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: var(--label-2); pointer-events: none; }
    #search {
      width: 100%; height: 100%; padding: 0 14px 0 38px; border: 1px solid transparent;
      border-radius: var(--r-sm); background: var(--fill); font-size: 15px; letter-spacing: -0.01em;
    }
    #search:focus { background: rgba(118,118,128,0.34); border-color: rgba(10,132,255,0.7); box-shadow: 0 0 0 4px rgba(10,132,255,0.22); }
    .header-actions { display: flex; align-items: center; gap: 6px; flex-shrink: 0; }
    .icon-btn {
      width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center;
      background: var(--fill); color: var(--label); transition: all 0.3s var(--ease);
    }
    .icon-btn:hover { transform: scale(1.08); background: rgba(118,118,128,0.36); box-shadow: var(--shadow-sm); }
    .icon-btn.active { background: linear-gradient(180deg, #2b95ff, var(--blue)); color: #fff; box-shadow: inset 0 1px 0 rgba(255,255,255,0.3), 0 6px 18px rgba(10,132,255,0.45); }
    #map { position: fixed; inset: 0; z-index: 0; background: #0b0b0d; }
    .maplibregl-ctrl-top-right, .maplibregl-ctrl-top-left { top: calc(var(--header-offset) - 4px); }
    .maplibregl-ctrl-group {
      background: var(--panel) !important; -webkit-backdrop-filter: var(--blur); backdrop-filter: var(--blur);
      border: 1px solid var(--stroke); border-radius: var(--r-md) !important; box-shadow: var(--shadow-sm) !important; overflow: hidden;
    }
    .maplibregl-ctrl-group button { width: 38px; height: 38px; }
    .maplibregl-popup-content {
      background: var(--panel-strong); -webkit-backdrop-filter: var(--blur); backdrop-filter: var(--blur);
      color: var(--label); border: 1px solid var(--stroke); border-radius: var(--r-md);
      box-shadow: var(--shadow); padding: 10px 14px; font: 500 14px/1.35 var(--font);
    }
    .maplibregl-popup-tip { display: none; }
    .mini-card {
      position: fixed; left: calc(16px + var(--safe-l)); bottom: calc(16px + var(--safe-b));
      width: 368px; max-height: calc(100dvh - var(--header-offset) - 28px - var(--safe-b));
      overflow-y: auto; overscroll-behavior: contain; padding: 20px; border-radius: var(--r-lg); z-index: 30; display: none;
    }
    .mini-card.show, .mini-card.open, .mini-card.active, .mini-card.visible, .mini-card.is-open,
    .mini-card[style*="block"], .mini-card[style*="flex"] { display: block; animation: cardIn 0.5s var(--spring) both; }
    #mini-title { margin: 0 0 4px; font-size: 21px; font-weight: 700; letter-spacing: -0.025em; line-height: 1.2; }
    #mini-addr { margin: 0; display: flex; align-items: flex-start; gap: 6px; color: var(--label-2); font-size: 14px; }
    #mini-buses { display: flex; flex-wrap: wrap; gap: 6px; margin: 14px 0 16px; }
    .bus-chip, #mini-buses > * {
      display: inline-flex; align-items: center; justify-content: center; min-width: 38px; height: 28px;
      padding: 0 10px; border-radius: 9px; background: var(--blue-tint); color: var(--blue-text);
      font-size: 14px; font-weight: 600; font-variant-numeric: tabular-nums;
    }
    #mini-info {
      display: grid; border-radius: var(--r-md); background: var(--fill-3); border: 0.5px solid var(--stroke); overflow: hidden; font-size: 14px;
    }
    #mini-info > * {
      display: flex; align-items: center; gap: 10px; min-height: 44px; padding: 8px 14px; margin: 0;
    }
    #mini-info > * + * { border-top: 0.5px solid var(--separator); }
    .btn-primary, #mini-btn {
      width: 100%; height: 48px; margin-top: 16px; display: inline-flex; align-items: center; justify-content: center;
      gap: 8px; border-radius: 14px; background: linear-gradient(180deg, #2e96ff 0%, var(--blue) 100%);
      color: #fff; font-size: 16px; font-weight: 600; box-shadow: inset 0 1px 0 rgba(255,255,255,0.28), 0 6px 18px rgba(10,132,255,0.32);
      transition: all 0.3s var(--ease);
    }
    #mini-btn:hover { transform: translateY(-1px); box-shadow: inset 0 1px 0 rgba(255,255,255,0.3), 0 10px 28px rgba(10,132,255,0.5); }
    .stop-page {
      position: fixed; inset: 0; z-index: 50; display: none; overflow-y: auto;
      padding: calc(var(--safe-t) + 32px) 24px calc(var(--safe-b) + 32px);
      background: rgba(0, 0, 0, 0.5); -webkit-backdrop-filter: blur(14px) saturate(140%); backdrop-filter: blur(14px) saturate(140%);
    }
    .stop-page.show, .stop-page.open, .stop-page.active, .stop-page.visible, .stop-page.is-open,
    .stop-page[style*="block"], .stop-page[style*="flex"] { display: block; animation: fadeIn 0.3s var(--ease) both; }
    #stop-page-content {
      position: relative; max-width: 880px; margin: 0 auto; padding: 28px 32px 36px;
      border-radius: var(--r-lg); background: var(--panel-strong); -webkit-backdrop-filter: var(--blur); backdrop-filter: var(--blur);
      border: 1px solid var(--stroke); box-shadow: var(--shadow); animation: slideUp 0.6s var(--spring) both;
    }
    #stop-page-content::after {
      content: ""; position: absolute; inset: 0 0 auto 0; height: 220px; border-radius: var(--r-lg) var(--r-lg) 0 0;
      background: radial-gradient(60% 100% at 15% 0%, rgba(10,132,255,0.22), transparent 70%), radial-gradient(50% 90% at 90% 0%, rgba(191,90,242,0.14), transparent 70%);
      pointer-events: none; z-index: 0;
    }
    #stop-page-content > * { position: relative; z-index: 1; }
    .back-btn, #stop-page-content > button:first-child {
      position: sticky; top: 0; z-index: 5; display: inline-flex; align-items: center; gap: 2px;
      height: 36px; padding: 0 14px 0 8px; border-radius: 18px; background: rgba(58,58,60,0.7);
      -webkit-backdrop-filter: var(--blur); backdrop-filter: var(--blur); border: 0.5px solid var(--stroke);
      color: var(--blue-text); font-size: 15px; font-weight: 600;
    }
    #stop-page-content h1 {
      margin: 20px 0 8px; font-size: clamp(30px, 5.2vw, 46px); font-weight: 800; line-height: 1.08; letter-spacing: -0.035em;
      background: linear-gradient(120deg, #ffffff 0%, #d6e9ff 45%, #5aaaff 100%);
      -webkit-background-clip: text; background-clip: text; color: transparent;
    }
    #stop-page-content section { margin-top: 28px; }
    #stop-page-content h2 { margin: 0 0 12px; font-size: 20px; font-weight: 700; letter-spacing: -0.02em; line-height: 1.25; }
    #stop-page-content p { margin: 0; color: var(--label-2); font-size: 15px; line-height: 1.6; }
    .description { padding: 18px 20px; border-radius: var(--r); background: var(--fill-3); border: 0.5px solid var(--stroke); }
    .routes, .bus-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(68px, 1fr)); gap: 10px; }
    .routes > *, .bus-grid > * {
      height: 60px; display: grid; place-items: center; border-radius: var(--r-md);
      background: linear-gradient(180deg, rgba(10,132,255,0.24), rgba(10,132,255,0.12));
      border: 0.5px solid rgba(10,132,255,0.3); color: #fff; font-size: 21px; font-weight: 700;
    }
    .infra { display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 10px; margin: 0; padding: 0; list-style: none; }
    .infra > * {
      display: flex; align-items: center; gap: 12px; padding: 14px 16px; border-radius: var(--r-md);
      background: var(--fill-3); border: 0.5px solid var(--stroke);
    }
    .infra .value { margin-left: auto; font-size: 17px; font-weight: 700; font-variant-numeric: tabular-nums; }
    .schedule { border-radius: var(--r); background: var(--fill-3); border: 0.5px solid var(--stroke); overflow: hidden; }
    .schedule-row { display: flex; align-items: flex-start; gap: 14px; padding: 14px 16px; }
    .schedule-row + .schedule-row { border-top: 0.5px solid var(--separator); }
    .times { display: flex; flex-wrap: wrap; gap: 6px; }
    .time, .time-chip { display: inline-flex; align-items: center; height: 28px; padding: 0 10px; border-radius: var(--r-xs); background: var(--fill-2); font-size: 14px; font-weight: 500; }
    .time.past, .time-chip.past { opacity: 0.35; }
    .time.next, .time-chip.next { background: var(--blue); color: #fff; font-weight: 700; box-shadow: 0 4px 14px rgba(10,132,255,0.45); }
    .nearby { display: flex; flex-wrap: wrap; gap: 8px; }
    .nearby-btn {
      display: inline-flex; align-items: center; gap: 6px; min-height: 40px; padding: 0 12px 0 16px;
      border-radius: 14px; background: var(--fill-2); border: 0.5px solid var(--stroke); font-size: 15px; font-weight: 500;
    }
    #mini-map { width: 100%; height: 300px; border-radius: var(--r); overflow: hidden; border: 1px solid var(--stroke); background: #0b0b0d; }
    @media (max-width: 640px) {
      :root { --header-h: 52px; --header-gap: 8px; }
      .app-header { width: calc(100% - 16px - var(--safe-l) - var(--safe-r)); padding: 6px; gap: 8px; border-radius: 26px; }
      .logo-icon { width: 38px; height: 38px; border-radius: 11px; }
      .logo-text { display: none; }
      .icon-btn { width: 38px; height: 38px; }
      .mini-card { left: calc(8px + var(--safe-l)); right: calc(8px + var(--safe-r)); bottom: calc(8px + var(--safe-b)); width: auto; padding: 18px 16px 16px; border-radius: 30px; }
      .stop-page { padding: 0; background: #000; }
      #stop-page-content { min-height: 100dvh; max-width: none; padding: calc(var(--safe-t) + 12px) calc(18px + var(--safe-r)) calc(var(--safe-b) + 32px) calc(18px + var(--safe-l)); border-radius: 0; border: 0; box-shadow: none; background: #000; }
      .infra { grid-template-columns: 1fr 1fr; }
      #mini-map { height: 240px; }
    }
  </style>
</head>
